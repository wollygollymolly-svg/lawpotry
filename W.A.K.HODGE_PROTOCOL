// Module: AMP-F-001 Ternary Gate & FlowEngine Hardware Core (Lattice iCE40)
// Lead Architect: Will Andrew Kenneth Hodge (W.A.K. Hodge)
// Target: Lattice iCE40UP5K / iCE40HX1K (Open-Source Yosys + nextpnr-ice40)
// ============================================================================

module amp_f001_ternary_gate (
    input  wire       clk,          // 12 MHz / 48 MHz iCE40 oscillator
    input  wire       rst_n,        // Active-low hardware reset
    input  wire [1:0] trit_in,      // 2'b00=0 (Align), 2'b11=-1 (Withdraw), 2'b01=+1 (Kinetic)
    input  wire       half_pulse,   // Incoming 0.5 remainder pulse
    input  wire [2:0] flow_cmd,     // 0=IDLE, 1=GATHER, 2=RUPTURE, 3=RELEASE, 4=REFORM, 5=UPGRADE
    output reg  [1:0] trit_out,     // Current 3-state hardware output
    output reg  [2:0] flow_state,   // FlowEngine container state (Depth 0 -> 2)
    output reg        half_rem,     // 1-bit 0.5 remainder buffer flag
    output reg        invariant_err // High if direct 0 -> +1 bypass attempted
);

    // Balanced 2-Bit Ternary Encodings
    localparam [1:0] T_ALIGN    = 2'b00; //  0 (K_0)
    localparam [1:0] T_KINETIC  = 2'b01; // +1 (W_1)
    localparam [1:0] T_FLUX_ERR = 2'b10; //  X (Invalid/Trap state)
    localparam [1:0] T_WITHDRAW = 2'b11; // -1 (A_X)

    // FlowEngine Spatial States (Trade-Lang Protocol)
    localparam [2:0] F_RELEASE  = 3'd0;  // IDLE: Root
    localparam [2:0] F_GATHER   = 3'd1;  // PUSH -> Container_1
    localparam [2:0] F_RUPTURE  = 3'd2;  // POP  -> Exited Container_1
    localparam [2:0] F_REFORM   = 3'd3;  // PUSH -> Container_1 (Re-aligned)
    localparam [2:0] F_UPGRADE  = 3'd4;  // PUSH -> Container_2 (Depth 2 Locked)

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            trit_out      <= T_ALIGN;
            flow_state    <= F_RELEASE;
            half_rem      <= 1'b0;
            invariant_err <= 1'b0;
        end else begin
            invariant_err <= 1'b0;

            // 1. Trap illegal 2'b10 state into safe Withdrawal (-1)
            if (trit_in == T_FLUX_ERR) begin
                trit_out   <= T_WITHDRAW;
                flow_state <= F_RUPTURE;
            end
            // 2. Enforce W.A.K. Non-Bypassable Invariant: K_0 (0) cannot jump directly to W_1 (+1)
            else if (trit_out == T_ALIGN && trit_in == T_KINETIC) begin
                trit_out      <= T_WITHDRAW; // Divert into A_X reflection first
                flow_state    <= F_REFORM;
                invariant_err <= 1'b1;
            end
            // 3. Half-Integer Conservation Buffer (0.5 + 0.5 -> +1 Kinetic emission)
            else if (half_pulse) begin
                if (half_rem == 1'b0) begin
                    half_rem <= 1'b1;        // Hold 0.5 in A_X buffer
                    trit_out <= T_WITHDRAW;
                end else begin
                    half_rem <= 1'b0;        // Pair resolved -> emit +1
                    trit_out <= T_KINETIC;
                end
            end
            // 4. Standard FlowEngine State Transitions
            else begin
                trit_out <= trit_in;
                case (flow_cmd)
                    3'd1: flow_state <= F_GATHER;
                    3'd2: flow_state <= F_RUPTURE;
                    3'd3: flow_state <= F_RELEASE;
                    3'd4: flow_state <= F_REFORM;
                    3'd5: flow_state <= (trit_out == T_WITHDRAW || trit_out == T_KINETIC) ? F_UPGRADE : F_REFORM;
                    default: flow_state <= flow_state;
                endcase
            end
        end
    end
endmodule
